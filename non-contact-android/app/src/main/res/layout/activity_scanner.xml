<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen QR scanner layout.
     PreviewView fills the screen. A semi-transparent overlay with a
     viewport cutout guides the user. Close button top-right, guide text below. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview — full screen behind everything -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay: top half -->
    <View
        android:id="@+id/overlayTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewportGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Viewport guide — transparent rectangle that hints the scan area -->
    <View
        android:id="@+id/viewportGuide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/viewport_border"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.64"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay: bottom half -->
    <View
        android:id="@+id/overlayBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toBottomOf="@id/viewportGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay: left of viewport -->
    <View
        android:id="@+id/overlayLeft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="@id/viewportGuide"
        app:layout_constraintBottom_toBottomOf="@id/viewportGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/viewportGuide" />

    <!-- Overlay: right of viewport -->
    <View
        android:id="@+id/overlayRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="@id/viewportGuide"
        app:layout_constraintBottom_toBottomOf="@id/viewportGuide"
        app:layout_constraintStart_toEndOf="@id/viewportGuide"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Close button — top right -->
    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Cerrar escáner"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#ffffff"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guide text below the viewport -->
    <TextView
        android:id="@+id/guideText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Apunta al código QR"
        android:textColor="#e0e0e0"
        android:textSize="16sp"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/viewportGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
